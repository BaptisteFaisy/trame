{
  "name": "trame",
  "version": "0.1.0",
  "private": true,
  "description": "Trame - Forge app for Jira: the coverage of your acceptance criteria, holes and perforations (Codegeist 2026)",
  "type": "module",
  "scripts": {
    "check:limits": "python3 tools/check-file-limits.py",
    "lint": "forge lint",
    "site:build": "vite build --config site/vite.config.ts",
    "site:typecheck": "tsc -p site/tsconfig.json --noEmit",
    "site:dev": "vite --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@forge/manifest": "^1.5.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/events": "^2.0.0",
    "@forge/llm": "^1.0.0",
    "@forge/react": "^10.0.0",
    "@forge/resolver": "^1.6.0",
    "@forge/sql": "^4.0.10"
  }
}
